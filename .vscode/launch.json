{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug KeyLangSwitcher",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/KeyLangSwitcher/bin/Debug/net8.0-windows/KeyLangSwitcher.exe",
            "args": [],
            "cwd": "${workspaceFolder}/KeyLangSwitcher",
            "console": "internalConsole",
            "stopAtEntry": false,
            "requireExactSource": false
        },
        {
            "name": "Debug KeyLangSwitcher (no build)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/KeyLangSwitcher/bin/Debug/net8.0-windows/KeyLangSwitcher.exe",
            "args": [],
            "cwd": "${workspaceFolder}/KeyLangSwitcher",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Attach to KeyLangSwitcher",
            "type": "coreclr",
            "request": "attach",
            "processName": "KeyLangSwitcher.exe"
        }
    ]
}
