{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Oops",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Oops/bin/Debug/net8.0-windows/oops.exe",
            "args": [],
            "cwd": "${workspaceFolder}/Oops",
            "console": "internalConsole",
            "stopAtEntry": false,
            "requireExactSource": false
        },
        {
            "name": "Debug Oops (no build)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/Oops/bin/Debug/net8.0-windows/oops.exe",
            "args": [],
            "cwd": "${workspaceFolder}/Oops",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Attach to Oops",
            "type": "coreclr",
            "request": "attach",
            "processName": "oops.exe"
        }
    ]
}
