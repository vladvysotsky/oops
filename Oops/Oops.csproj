<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>oops</AssemblyName>
    <RootNamespace>Oops</RootNamespace>
    <!-- Значение для локальных сборок. В релизах CI подставляет версию из тега. -->
    <Version>1.3.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Иконка вшивается в сборку, а не кладётся файлом рядом: при single-file
         публикации и установке отдельный файл до места не доезжает, и в трее
         оставалась системная заглушка. ApplicationIcon выше — это иконка самого
         exe в проводнике, она берётся из того же файла на этапе сборки. -->
    <EmbeddedResource Include="Resources\icon.ico" />
    <!-- Строки интерфейса. Именно встроенными ресурсами, а не .resx с
         сателлитными сборками: при PublishSingleFile сателлиты не попадают
         внутрь exe, а раскладываются в подпапки культур рядом — портативный
         архив собирается из одного файла и потерял бы переводы.

         ПОДЧЁРКИВАНИЕ В ИМЕНИ ОБЯЗАТЕЛЬНО. При «lang.ru.json» MSBuild видит
         «.ru.» и считает файл ресурсом культуры ru — тогда он уходит в
         сателлитную сборку ru\, а из главной пропадает: приложение падало на
         старте с «не найден ресурс Oops.Resources.lang.en.json». WithCulture
         отключает это распознавание, имя с подчёркиванием — вторая страховка. -->
    <EmbeddedResource Include="Resources\lang_ru.json" WithCulture="false" />
    <EmbeddedResource Include="Resources\lang_en.json" WithCulture="false" />
  </ItemGroup>

</Project>
