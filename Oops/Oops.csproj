<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>oops</AssemblyName>
    <RootNamespace>Oops</RootNamespace>
    <!-- Значение для локальных сборок. В релизах CI подставляет версию из тега. -->
    <Version>1.3.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <!-- Нативная bergamot.dll обязана оказаться ВНУТРИ single-file exe. Без
         этого флага .NET кладёт нативные библиотеки отдельными файлами рядом
         с exe: портативный архив собирается из одного файла, и перевод в нём
         молча не работал бы («не удалось загрузить библиотеку»). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Локальный перевод RU<->EN движком Bergamot — тем же, что в Firefox.
         MPL-2.0. Сама библиотека весит ~22 МБ на win-x64; модели в неё не
         входят и скачиваются отдельно (Core/ModelStore.cs). -->
    <PackageReference Include="BergamotTranslatorSharp" Version="0.5.1" />
    <!-- Голосовой ввод: распознавание речи целиком на машине. Whisper.net —
         обёртка над whisper.cpp, Runtime несёт нативные библиотеки, NAudio
         снимает звук с микрофона. Модель (~465 МБ) в пакет не входит и
         скачивается отдельно, как и модели перевода. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="NAudio" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иконка вшивается в сборку, а не кладётся файлом рядом: при single-file
         публикации и установке отдельный файл до места не доезжает, и в трее
         оставалась системная заглушка. ApplicationIcon выше — это иконка самого
         exe в проводнике, она берётся из того же файла на этапе сборки. -->
    <EmbeddedResource Include="Resources\icon.ico" />
    <!-- Строки интерфейса. Именно встроенными ресурсами, а не .resx с
         сателлитными сборками: при PublishSingleFile сателлиты не попадают
         внутрь exe, а раскладываются в подпапки культур рядом — портативный
         архив собирается из одного файла и потерял бы переводы.

         ПОДЧЁРКИВАНИЕ В ИМЕНИ ОБЯЗАТЕЛЬНО. При «lang.ru.json» MSBuild видит
         «.ru.» и считает файл ресурсом культуры ru — тогда он уходит в
         сателлитную сборку ru\, а из главной пропадает: приложение падало на
         старте с «не найден ресурс Oops.Resources.lang.en.json». WithCulture
         отключает это распознавание, имя с подчёркиванием — вторая страховка. -->
    <EmbeddedResource Include="Resources\lang_ru.json" WithCulture="false" />
    <EmbeddedResource Include="Resources\lang_en.json" WithCulture="false" />
  </ItemGroup>

</Project>
